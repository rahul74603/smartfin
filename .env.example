# Copy to .env and fill in to point at a different Firebase project.
# Web API keys are project identifiers, not secrets — access is controlled by
# Firebase Security Rules and the Authorized Domains allowlist.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
